{
  "version": 2,
  "builds": [
    {
      "src": "danmu_api/worker.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/([^/]+)/api/(.*)",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/(.*)",
      "dest": "/danmu_api/worker.js"
    }
  ],
  "env": {
    "SOURCE_ORDER": "douban,360,renren,hanjutv,dandan,bahamut",
    "RATE_LIMIT_MAX_REQUESTS": "0"
  }
}
